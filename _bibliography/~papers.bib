	date-added = {2023-02-09 07:51:06 -0700},
	date-modified = {2024-03-25 14:34:12 -0600},
	doi = {10.36688/ewtec-2023-288},
	journal = {Proceedings of the European Wave and Tidal Energy Conference},
	month = {September},
	title = {Control co-design and uncertainty analysis of the {LUPA}'s {PTO} using {WecOptTool}},
