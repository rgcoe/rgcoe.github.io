	series = {International Conference on Offshore Mechanics and Arctic Engineering},
	title = {NUMERICAL MODELING OF MOORED FLOATING PLATFORMS FOR WAVE ENERGY CONVERTERS USING {DUALSPHYSICS}: MODELING FOR TESTS UNDER EXTREME WAVES},
	url = {https://doi.org/10.1115/OMAE2022-78810},
