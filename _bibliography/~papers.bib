	doi = {10.23919/OCEANS.2015.7401878},
	keywords = {frequency-domain analysis;probability;wave power generation;frequency-domain model;WEC;short-term extreme response statistics;wave energy converters;short-term extreme response estimation;Wave Energy;WEC;Extreme Value;Short-Term Statistics;Design Load},
	month = {Oct},
