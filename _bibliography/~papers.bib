	doi = {10.1115/OMAE2022-80731},
	eprint = {https://asmedigitalcollection.asme.org/OMAE/proceedings-pdf/OMAE2022/85932/V008T09A073/6929644/v008t09a073-omae2022-80731.pdf},
	month = {06},
