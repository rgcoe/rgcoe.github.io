	journal = {Journal of Ocean Engineering and Marine Energy},
	month = {February},
	pages = {17-29},
	title = {A comparison of efficiency-aware model-predictive control approaches for wave energy devices},
	url = {https://doi.org/10.1007/s40722-021-00214-x},
