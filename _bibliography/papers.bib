	issn = {0141-1187},
	journal = {Applied Ocean Research},
	keywords = {Wave energy converter (WEC), Control, Wave tank, Model-scale testing},
	owner = {rcoe},
	pages = {351 - 366},
	timestamp = {2018.12.16},
	title = {Wave tank and bench-top control testing of a wave energy converter},
	url = {http://www.sciencedirect.com/science/article/pii/S0141118717307484},
