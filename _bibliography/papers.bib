@techreport{Forbush:2024aa,
	abstract = {Wave energy converters (WECs) are designed to produce useful work from ocean waves. This useful work can take the form of electrical power or even pressurized water for, e.g., desalination. This report details the findings from a wave tank test focused on that production of useful work. To that end, the experimental system and test were specifically designed to validate models for power transmission throughout the WEC system. Additionally, the validity of co-design informed changes to the power take-off (PTO) were assessed and shown to provide the expected improvements in system performance.},
	address = {Albuquerque, NM},
	author = {Forbush, Dominic D. and Coe, Ryan G. and Donnelly, Timothy and Coe, Ryan G. and Gallegos-Patterson, Damian and Spencer, Stephen J. and Spinneken, Johannes and Lee, Jantzen and Crandell, Robert and Dullea, Kevin},
