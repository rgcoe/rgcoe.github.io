@article{Abdelkhalik:2018aa,
	annote = {10.1115/1.4038860},
	author = {Abdelkhalik, Ossama and Zou, Shangyan and Robinett, Rush and Bacelli, Giorgio and Wilson, David and Coe, Ryan},
	bibtex_show = true,
	date = {2018/01/19},
	date-added = {2020-10-07 12:39:06 -0600},
	date-modified = {2025-06-25 12:01:07 -0600},
	doi = {10.1115/1.4038860},
