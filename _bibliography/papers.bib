	issn = {2198-6452},
	journal = {Journal of Ocean Engineering and Marine Energy},
	number = {4},
	owner = {rcoe},
	pages = {473--483},
	publisher = {Springer},
	timestamp = {2016.05.02},
	title = {On the control design of wave energy converters with wave prediction},
	url = {http://dx.doi.org/10.1007/s40722-016-0048-4},
