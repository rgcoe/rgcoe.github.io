	month = {September},
	slides = {https://www.osti.gov/biblio/1642748},
	title = {Evaluation of predictionless control for wave energy converters},
	url = {https://www.osti.gov/biblio/1641422},
	year = {2019},
	bdsk-url-1 = {https://www.researchgate.net/publication/338374910_Evaluation_of_predictionless_control_for_wave_energy_converters}}

