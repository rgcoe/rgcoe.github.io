	issn = {1939-9367},
	journal = {IEEE Transactions on Industry Applications},
	keywords = {Mathematical model;Impedance;Force;Impedance matching;Iron;Absorption;Transfer functions;Control systems;energy conversion;identifi-cation;impedance matching;resonance},
	month = {March},
	number = {2},
	pages = {{1862-1868}},
	title = {Feedback Resonating Control for a Wave Energy Converter},
	url = {https://ieeexplore.ieee.org/document/8926523},
