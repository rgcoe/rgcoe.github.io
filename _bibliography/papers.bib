	journal = {International Marine Energy Journal},
	month = {Dec.},
	number = {3},
	pages = {327--338},
	title = {A Self-Tuning {WEC} Controller For Changing Sea States},
	url = {https://marineenergyjournal.org/imej/article/view/70},
	volume = {5},
	year = {2022},
